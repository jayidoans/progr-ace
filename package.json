{
  "name": "progr-ace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:production": "tsx scripts/production-build.ts next",
    "build:cloudflare:production": "tsx scripts/production-build.ts cloudflare",
    "build:demo": "tsx scripts/demo-build.ts next",
    "build:cloudflare:demo": "tsx scripts/demo-build.ts cloudflare",
    "provision:demo": "tsx scripts/provision-demo.ts",
    "smoke:demo:read-only": "tsx scripts/smoke-demo-read-only.ts",
    "preview": "npm run build:cloudflare:production && opennextjs-cloudflare preview",
    "deploy": "npm run deploy:production",
    "deploy:production": "npm run build:cloudflare:production && opennextjs-cloudflare deploy",
    "deploy:demo": "npm run build:cloudflare:demo && opennextjs-cloudflare deploy --config wrangler.demo.jsonc",
    "upload": "npm run upload:production",
    "upload:production": "npm run build:cloudflare:production && opennextjs-cloudflare upload",
    "upload:demo": "npm run build:cloudflare:demo && opennextjs-cloudflare upload --config wrangler.demo.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "test:training": "tsx --test src/features/training-import/tests/*.test.ts",
    "test:activities": "tsx --test src/features/activities/tests/*.test.ts",
    "test:validation": "tsx --test src/features/validation/engine/*.test.ts",
    "test:strava": "tsx --test src/features/strava/tests/*.test.ts",
    "test:demo": "tsx --test src/features/demo/*.test.ts",
    "test:demo:db": "supabase db query --local --file supabase/demo/0001_read_only_hardening.sql && supabase test db supabase/demo/tests/demo_read_only_hardening.test.sql"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "next": "15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "1.20.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "postcss": "^8",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "4.132.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
